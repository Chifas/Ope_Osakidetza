<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_margin="6dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#1565C0"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"
        android:text="Pregunta 1" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#212121"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="12dp"
        android:text="Texto de la pregunta" />

    <TextView
        android:id="@+id/tvOpt0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:text="A. Opción" />

    <TextView
        android:id="@+id/tvOpt1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:text="B. Opción" />

    <TextView
        android:id="@+id/tvOpt2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:padding="8dp"
        android:layout_marginBottom="4dp"
        android:text="C. Opción" />

    <TextView
        android:id="@+id/tvOpt3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:padding="8dp"
        android:text="D. Opción" />

</LinearLayout>
