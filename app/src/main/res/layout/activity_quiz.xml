<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- Ambient Glow Superior -->
    <View
        android:layout_width="1000dp"
        android:layout_height="1000dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-450dp"
        android:layout_marginTop="-450dp"
        android:alpha="0.5"
        android:background="@drawable/bg_ambient_glow" />

    <!-- Ambient Glow Inferior -->
    <View
        android:layout_width="1200dp"
        android:layout_height="1200dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-500dp"
        android:layout_marginBottom="-500dp"
        android:alpha="0.6"
        android:background="@drawable/bg_ambient_glow" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header bar Premium con fondo sólido para tapar el resplandor -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F4F6F9"
            android:elevation="4dp"
            android:paddingTop="32dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Salir"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="@+id/tvProgress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvProgress"
                app:tint="#1F2937" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Pregunta 1 de 20"
                android:textColor="#6B7280"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@+id/btnBack"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:progress="5"
                app:indicatorColor="#4F46E5"
                app:layout_constraintTop_toBottomOf="@+id/tvProgress"
                app:trackColor="#E5E7EB"
                app:trackThickness="6dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Question Area -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/footerLayout"
            app:layout_constraintTop_toBottomOf="@id/headerBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingExtra="8dp"
                    android:text="Texto de la pregunta"
                    android:textColor="#1F2937"
                    android:textSize="22sp" />

                <!-- Opciones (Cards blancas para bloquear el fondo) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption0"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="72dp"
                    android:paddingHorizontal="20dp"
                    android:text="A. Opción"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption1"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="72dp"
                    android:paddingHorizontal="20dp"
                    android:text="B. Opción"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption2"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="72dp"
                    android:paddingHorizontal="20dp"
                    android:text="C. Opción"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOption3"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    android:gravity="start|center_vertical"
                    android:minHeight="72dp"
                    android:paddingHorizontal="20dp"
                    android:text="D. Opción"
                    android:textColor="#374151"
                    android:textSize="16sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Footer Simétrico -->
        <LinearLayout
            android:id="@+id/footerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingBottom="40dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevious"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:elevation="4dp"
                android:text="Anterior"
                android:textColor="#4F46E5"
                android:textSize="18sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:elevation="8dp"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:text="Siguiente"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#4F46E5"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
