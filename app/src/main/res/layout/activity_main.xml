<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- Ambient Glow Superior: Contenedor gigante (1200dp) para asegurar difuminado total -->
    <View
        android:layout_width="1200dp"
        android:layout_height="1200dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-500dp"
        android:layout_marginTop="-500dp"
        android:background="@drawable/bg_ambient_glow"
        android:alpha="0.6" />

    <!-- Ambient Glow Inferior: Contenedor gigante (1400dp) -->
    <View
        android:layout_width="1400dp"
        android:layout_height="1400dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-600dp"
        android:layout_marginBottom="-600dp"
        android:background="@drawable/bg_ambient_glow"
        android:alpha="0.7" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Header -->
                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03"
                    android:text="¡Hola, Itsaso! 👋"
                    android:textColor="#1F2937"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="32dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tu camino a la plaza empieza aquí."
                    android:textColor="#6B7280"
                    android:textSize="16sp" />

                <!-- Secciones de Temario (Cards MD3 con elevación para tapar el brillo) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed-light"
                    android:letterSpacing="0.1"
                    android:text="Temario Común"
                    android:textAllCaps="true"
                    android:textColor="#4F46E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <!-- Contenido Card -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnComunQuick" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="Rápido\n(20)" android:textColor="#4F46E5" app:backgroundTint="#EEF2FF" app:cornerRadius="18dp" app:icon="@drawable/ic_timer" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnComunFull" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="Completo\n(100)" android:textColor="#4F46E5" app:backgroundTint="#EEF2FF" app:cornerRadius="18dp" app:icon="@drawable/ic_assignment" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Repetir estructura para Específico y All con elevación -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed-light"
                    android:letterSpacing="0.1"
                    android:text="Temario Específico"
                    android:textAllCaps="true"
                    android:textColor="#4F46E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnEspecQuick" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="Rápido\n(20)" android:textColor="#4F46E5" app:backgroundTint="#EEF2FF" app:cornerRadius="18dp" app:icon="@drawable/ic_timer" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnEspecFull" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="Completo\n(100)" android:textColor="#4F46E5" app:backgroundTint="#EEF2FF" app:cornerRadius="18dp" app:icon="@drawable/ic_assignment" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-condensed-light"
                    android:letterSpacing="0.1"
                    android:text="Todo el Temario"
                    android:textAllCaps="true"
                    android:textColor="#4F46E5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAllQuick" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="Rápido\n(20)" android:textColor="#4F46E5" app:backgroundTint="#EEF2FF" app:cornerRadius="18dp" app:icon="@drawable/ic_timer" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAllFull" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="Completo\n(100)" android:textColor="#4F46E5" app:backgroundTint="#EEF2FF" app:cornerRadius="18dp" app:icon="@drawable/ic_assignment" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CTA Principal con elevación para forzar Z-index sobre los glows -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStudy"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Modo Estudio"
                    android:textSize="18sp"
                    app:backgroundTint="#4F46E5"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFailed"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="40dp"
                    android:elevation="4dp"
                    android:text="Repasar Fallos (0)"
                    android:textColor="#4F46E5"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="24dp"
                    app:strokeColor="#334F46E5"
                    app:strokeWidth="1.5dp" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tu récord actual: 0/100"
                    android:textAlignment="center"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
