<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏥"
        android:textSize="52sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Osakidetza Quiz"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auxiliar de Administración"
        android:textSize="15sp"
        android:textColor="#757575"
        android:layout_marginBottom="40dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuick"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Test Rápido — 20 preguntas"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="#1565C0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFull"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Test Completo — 299 preguntas"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="#0D47A1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStudy"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Modo Estudio"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        app:backgroundTint="#2E7D32" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#757575"
        android:text="¡Empieza a practicar! (299 preguntas)" />

</LinearLayout>
